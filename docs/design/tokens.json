{
  "meta": {
    "name": "Trabecular design baseline",
    "version": "0.1.0",
    "updated": "2026-10-27",
    "status": "proposed-for-next-ui-pass",
    "description": "Project-authored design values. Not copied from references and not yet connected to runtime CSS.",
    "principles": "../../DESIGN_PRINCIPLES.md"
  },
  "color": {
    "page": "#080A0B",
    "surface": "#111517",
    "surfaceRaised": "#181D1F",
    "overlay": "#202628",
    "canvas": "#0B1011",
    "textPrimary": "#F1F3F2",
    "textSecondary": "#ADB5B1",
    "textMuted": "#8F9A94",
    "textOnAccent": "#172014",
    "accent": "#C5E5A8",
    "accentHover": "#D3EDBC",
    "success": "#92D4B0",
    "warning": "#E0BD80",
    "error": "#F09B94",
    "info": "#A9C6ED",
    "focus": "#C5E5A8",
    "controlBoundary": "#707B75",
    "dividerDecorative": "rgba(255,255,255,0.08)",
    "bone": "#D7D1C3",
    "hardware": "#B9C6CB",
    "keepOut": "#E0BD80",
    "chartSeries": ["#A9C6ED", "#C5E5A8", "#D5B6E6", "#E0BD80"],
    "stressField": ["#3157BD", "#2DA4CE", "#45C9A0", "#D5D764", "#EF9E43", "#E95355"]
  },
  "typography": {
    "sans": ["Inter Variable", "Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Arial", "sans-serif"],
    "mono": ["ui-monospace", "SFMono-Regular", "Cascadia Code", "Consolas", "monospace"],
    "fontLoading": "Bundle a licensed local font during implementation; retain system fallback and avoid a runtime remote-font requirement.",
    "weights": {"regular": 400, "medium": 500, "semibold": 600},
    "sizePx": {"metadataOptional": 11, "label": 12, "supporting": 13, "control": 14, "body": 15, "section": 16, "workspaceTitle": 22, "overviewTitle": 32, "metric": 36},
    "lineHeight": {"title": 1.15, "control": 1.4, "body": 1.5, "explanation": 1.65},
    "trackingEm": {"title": -0.025, "body": 0, "eyebrow": 0.08},
    "numericVariant": "tabular-nums",
    "criticalTextMinimumPx": 12
  },
  "spacePx": [4, 8, 12, 16, 24, 32, 48, 64],
  "radiusPx": {"compact": 8, "control": 12, "panel": 16, "dialog": 24, "pill": 999},
  "layout": {
    "navigationRailPx": 64,
    "topbarHeightPx": 56,
    "stageToolbarMaxHeightPx": 44,
    "inspectorDefaultWidthPx": 320,
    "inspectorMinWidthPx": 300,
    "inspectorMaxWidthPx": 340,
    "workspaceGutterPx": 24,
    "regionGapPx": 16,
    "panelPaddingPx": 24,
    "sectionGapPx": 24,
    "controlHeightPx": 40,
    "compactIconControlPx": 36,
    "touchTargetMinimumPx": 44,
    "assistantDockHeightPx": 44,
    "desktopCanvasWidthShare": [0.65, 0.75],
    "breakpointPx": {"mobile": 600, "tablet": 900, "compactDesktop": 1200, "wideDesktop": 1440}
  },
  "glass": {
    "floatingSurface": "rgba(24,29,31,0.88)",
    "solidFallback": "#181D1F",
    "backdropBlurPx": 16,
    "borderDecorative": "1px solid rgba(255,255,255,0.08)",
    "shadow": "0 16px 48px rgba(0,0,0,0.24)",
    "useFor": ["case-bar", "floating-tools", "assistant-dock", "dialogs"],
    "avoidFor": ["nested-section-cards", "dense-tables", "every-metric-row"]
  },
  "motion": {
    "hoverMs": 120,
    "panelMs": 180,
    "cameraMs": 240,
    "easing": "cubic-bezier(0.2,0,0,1)",
    "reducedMotionMs": 0,
    "autoRotateAnatomy": false,
    "decorativeLoopingAnimations": false
  },
  "accessibilityTargets": {
    "normalTextContrastMinimum": 4.5,
    "largeTextContrastMinimum": 3,
    "requiredControlCueContrastMinimum": 3,
    "focusOutlinePx": 2,
    "focusOutlineOffsetPx": 3,
    "notes": "Check actual composited backgrounds, required cues, real states and zoom during implementation. Token checks alone do not establish conformance."
  }
}
